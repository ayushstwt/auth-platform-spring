{
  "openapi": "3.0.1",
  "info": {
    "title": "Ayshriv Auth Platform API",
    "description": "Production-grade Authentication and Identity Platform API specification",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Application status UP"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": ["Security"],
        "summary": "Public JWKS key set for JWT verification",
        "responses": {
          "200": {
            "description": "JSON Web Key Set containing active and rotated public keys"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Validation failed" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["identifier", "password"],
                "properties": {
                  "identifier": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful returning access and refresh token" },
          "401": { "description": "Invalid credentials or account locked" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate refresh token and issue new access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens refreshed" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "List active user sessions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of active sessions" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "tags": ["Sessions"],
        "summary": "Revoke all sessions except current",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "All sessions revoked" }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User details" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Soft delete user account",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Account soft-deleted" }
        }
      }
    },
    "/api/v1/users/me/export": {
      "get": {
        "tags": ["Users"],
        "summary": "Export personal user data (GDPR)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Complete exported data object" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
