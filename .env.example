# ==============================================================================
# user-service Environment Configuration Template
# Copy this file to .env and configure the appropriate values.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Server configuration
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userservice_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Test Database Configuration (PostgreSQL - Used for local test verification)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=userservice_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=postgres

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id,Accept,Origin
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=3600

# JWT & Keys
JWT_ISSUER=auth-platform-spring
JWT_AUDIENCE=auth-platform-spring-api
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=

# Account Lockout & Email Policy
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_REQUIRE_VERIFIED_EMAIL=true

# Generic OTP Engine Configuration (Phase 3)
OTP_PEPPER=your-secure-otp-pepper-secret-string-at-least-32-chars!
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# SMTP Email Configuration (Phase 3)
SPRING_MAIL_HOST=smtp.mailprovider.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-smtp-user
SPRING_MAIL_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Ayshriv Auth Platform"
# Note on DNS: Ensure SPF (v=spf1 include:...), DKIM (public key TXT record), and DMARC (p=reject/quarantine) are configured on your sending domain.

# SMS & Phone Configuration (Phase 4)
SMS_PROVIDER=logging
SMS_DEFAULT_REGION=IN
SMS_ALLOWED_COUNTRY_CODES=IN,US,GB
SMS_BLOCKED_PREFIXES=+1900,+1976,+4490
SMS_MAX_SENDS_PER_HOUR_PHONE=5
SMS_MAX_SENDS_PER_HOUR_IP=20
SMS_MAX_SENDS_PER_HOUR_USER=5
SMS_GLOBAL_HOURLY_CAP=100
SMS_DAILY_COST_GUARD_LIMIT=500

# Twilio SMS Credentials (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE_NUMBER=+15551234567

# Google OAuth 2.0 / OpenID Connect (Phase 5)
GOOGLE_CLIENT_IDS=your-client-id-web.apps.googleusercontent.com,your-client-id-mobile.apps.googleusercontent.com
GOOGLE_HOSTED_DOMAIN=
GOOGLE_REDIRECT_FLOW_ENABLED=false
GOOGLE_REDIRECT_SUCCESS_URL=http://localhost:3000/oauth2/callback
GOOGLE_EXCHANGE_CODE_TTL_SECONDS=60
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Multi-Factor Authentication (Phase 6)
# Current key ID used for encrypting new TOTP secrets
MFA_CURRENT_KEY_ID=k1
# AES-256 keys (32 bytes raw, 64 hex chars, or 44 chars Base64: openssl rand -base64 32)
MFA_ENCRYPTION_KEY_K1=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Retain older keys here for seamless key rotation:
# MFA_ENCRYPTION_KEY_K0=...
MFA_TOKEN_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_STEP_UP_VALIDITY_MINUTES=15
MFA_ENFORCE_FOR_ADMIN=true
MFA_ISSUER="Ayshriv Auth"

